{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "types": ["$app/types", "unplugin-icons/types/svelte"],
    "rewriteRelativeImportExtensions": true,
    "sourceMap": true,
    "strict": true,
    "paths": {
      "$velite": ["./.velite"],
      "$velite/*": ["./.velite/*"]
    }
  },
  "include": ["src", "vite.config.ts", "playwright.config.ts"]
}
